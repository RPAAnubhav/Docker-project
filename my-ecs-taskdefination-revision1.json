{
    "containerDefinitions": [
        { 
            "name": "my-java-app",
            "image": "615299762140.dkr.ecr.us-east-1.amazonaws.com/my-ecr-repository:20250213104942",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "my-java-app-8080-tcp",
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp",
                    "appProtocol": "http"
                },
                {
                    "name": "my-java-app-80-tcp",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [],
            "environmentFiles": [],
            "mountPoints": [],
            "volumesFrom": [],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/my-ecs-taskdefination",
                    "mode": "non-blocking",
                    "awslogs-create-group": "true",
                    "max-buffer-size": "25m",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ],
    "family": "my-ecs-taskdefination",
    "taskRoleArn": "arn:aws:iam::615299762140:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::615299762140:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "cpu": "256",
    "memory": "512",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "tags": []
}
